{
  "name": "mazelingo-fx",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:firefox:lab": "MAZELINGO_FIREFOX_LAB=1 wxt -b firefox --mv3",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:local": "wxt build && jiti scripts/mirror-local.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "test": "vitest run && node --test scripts/verify-manifests.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:models": "node test/test_models.js",
    "test:llm": "jiti test/test_llm.ts",
    "lint": "oxlint",
    "lint:firefox": "npx --yes web-ext@10.6.0 lint --source-dir .output/firefox-mv3 --warnings-as-errors=false",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "verify:manifests": "node scripts/verify-manifests.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@webext-core/fake-browser": "^2.0.1",
    "dotenv": "^16.4.7",
    "jiti": "^2.7.0",
    "jsdom": "26.1.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
